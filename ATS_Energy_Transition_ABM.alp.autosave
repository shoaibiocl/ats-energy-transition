s += "opexVariablePerKWh\t" + format( opexVariablePerKWh ) + "\n";
s += "opexFixedPerKWPerYear\t" + format( opexFixedPerKWPerYear ) + "\n";
s += "loanDuration\t" + format( loanDuration ) + "\n";
s += "timeToCapacityExpansion\t" + format( timeToCapacityExpansion ) + "\n";
s += "randomness\t" + format( randomness ) + "\n";
s += "forecast_period\t" + format( forecast_period ) + "\n";
s += "capacityMultiplier\t" + format( getBestParamValue( _oqvar_capacityMultiplier ) ) + "\n";

copyToClipboard( s );]]></ActionCode>
