			<Variables>
				<Variable Class="AuxVariable">
					<Id>1752594884639</Id>
					<Name><![CDATA[totalElectricitySupply]]></Name>
					<Description><![CDATA[This gives value in TwH.]]></Description>
					<X>550</X><Y>150</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[
(Capacity.get(Solar)*availabilityFactor.get(Solar)*(8760)/(1000000) + 
(Capacity.get(Coal)*availabilityFactor.get(Coal) +
Capacity.get(NaturalGas)*availabilityFactor.get(NaturalGas) + 
Capacity.get(OffshoreWind)*availabilityFactor.get(OffshoreWind) +
Capacity.get(OnshoreWind)*availabilityFactor.get(OnshoreWind) + 
Capacity.get(Hydro)*availabilityFactor.get(Hydro) +
Capacity.get(Nuclear)*availabilityFactor.get(Nuclear) +
Capacity.get(Wave)*availabilityFactor.get(Wave) + 
Capacity.get(Biomass)*availabilityFactor.get(Biomass) +
Capacity.get(Others)*availabilityFactor.get(Others))*(8760)/(1000000))*(1+capacityMultiplier)]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-4073239</Color>
					</Properties>

				</Variable>
