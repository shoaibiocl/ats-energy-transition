		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1747061152596">
			<Id>1768321118936</Id>
			<Name><![CDATA[ParametersVariation_Average]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[deleteFrom(es).execute();]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeSimulationRunCode><![CDATA[//]]></BeforeSimulationRunCode>
			<AfterSimulationRunCode><![CDATA[int foundIndex=0;
for(int i = 0; i < root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset.size(); i++) {
    if (root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset.getY(i) == 1) { 
        foundIndex = i; // Store the index
        break; // Exit the loop once the first match is found
    }
}
insertInto(es)
  .columns( es.transition_time, 
  			es.capacity_expansion,
  			es.hydrogen_split, 
  			es.fractional_transition_other,
  			es.fractional_transition_ats,
  			es.max_hydrogen_price,
  			es.average_hydrogen_price,
  			es.min_hydrogen_price,
  			es.max_electricity_price,
  			es.average_electricity_price,
  			es.min_electricity_price,
  			es.ats_demand_satisfied_year,
  			es.max_proportaional_ats_demand_satisfied,
  			es.electricity_max_lf,
  			es.electricity_average_lf,
  			es.electricity_min,
  			es.years_to_transition_ats,
  			es.profit_margin)
  .values(root.yearsToTransition, 
  		  root.timeToCapacityExpansion,
  		  root.hydrogenSplitOtherSectors,
  	      root.fractionalTransitionOtherSectors, 
  	      root.fractionalTransitionATS,
  	      root.energyCoordinator.cordinator_hydrogenPrice_dataset.getYMax(),
  	      root.energyCoordinator.cordinator_hydrogenPrice_dataset.getYMean(),
  	      root.energyCoordinator.cordinator_hydrogenPrice_dataset.getYMin(),
  	      root.energyCoordinator.cordinator_electricityPrice_dataset.getYMax(),
  	      root.energyCoordinator.cordinator_electricityPrice_dataset.getYMean(),
  	      root.energyCoordinator.cordinator_electricityPrice_dataset.getYMin(),
  	      foundIndex,
  	      root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset.getYMax(),
  	      root.energyCoordinator.cordinator_electricityLoadFactor_dataset.getYMax(),
 	      root.energyCoordinator.cordinator_electricityLoadFactor_dataset.getYMean(),
  	      root.energyCoordinator.cordinator_electricityLoadFactor_dataset.getYMin(),
  	      root.yearsToTransitionATS,
  	      root.profitMargin  	      )
  	      .execute();]]></AfterSimulationRunCode>
