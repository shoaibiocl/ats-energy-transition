				<StatechartElement Class="Transition" ParentState="underTransition" ParentStateId="1759749590565">
					<Id>1759749671810</Id>
					<Name><![CDATA[transition3]]></Name>
					<X>215</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>-100</X><Y>0</Y></Point>
						<Point><X>-100</X><Y>35</Y></Point>
					</Points>
					<IconOffset>20.0</IconOffset>
					<Properties Source="1759749590565" Target="1759749590565" Trigger="timeout">
						<Action><![CDATA[getDemand();
for (int i = 1; i <= Sectors.size(); i++){
	// this is only for ATS
	if (i == 4){
		// Change values iff still in transition period
		if (nYears < years_to_transition_ATS){
			TotalEnergyDemand.set(TotalEnergyDemand.get(i, Fossil)
			-annualReduction.get(i), i, Fossil);
			TotalEnergyDemand.set(TotalEnergyDemand.get
			(i, Electricity)+annualReduction.get(i)*(1-hydrogenSplit_ATS), i, Electricity);
			TotalEnergyDemand.set(TotalEnergyDemand.get
			(i, Hydrogen)+annualReduction.get(i)*hydrogenSplit_ATS, i, Hydrogen);
			if(TotalEnergyDemand.get(i, Fossil) <= 0){
				annualReduction.set(0, i);
			}
		}
	} else {
	// Change values iff still in transition period
		if (nYears < years_to_transition_ATS){
		TotalEnergyDemand.set(TotalEnergyDemand.get(i, Fossil)
		-annualReduction.get(i), i, Fossil);
		TotalEnergyDemand.set(TotalEnergyDemand.get
		(i, Electricity)+annualReduction.get(i)*(1-hydrogenSplit), i, Electricity);
		TotalEnergyDemand.set(TotalEnergyDemand.get
		(i, Hydrogen)+annualReduction.get(i)*hydrogenSplit, i, Hydrogen);
		if(TotalEnergyDemand.get(i, Fossil) <= 0){
			annualReduction.set(0, i);
		}
		}
	}
}
//traceln("Total Hydrogen demand: "+ TotalEnergyDemand.sum(INDEX_CAN_VARY, Hydrogen));
nYears++;
remainingTransitionTime -=1;
remainingTransitionTimeATS -=1;
send("Demand updated", main.hydrogenProducer_PEM);]]></Action>
