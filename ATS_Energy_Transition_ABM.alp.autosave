			<BeforeSimulationRunCode><![CDATA[
excelFile.setCellValue("Year", "Sheet1", 1, 1);
excelFile.setCellValue("Hydrogen Price", "Sheet1", 1, 2);
excelFile.setCellValue("Electricity Price", "Sheet1", 1, 3);
excelFile.setCellValue("ATS hydrogen demand satisfied", "Sheet1", 1, 4);
excelFile.setCellValue("Hydrogen demand (ton)", "Sheet1", 1, 5);
excelFile.setCellValue("Hydrogen production (ton)", "Sheet1", 1, 6);
excelFile.setCellValue("Hydrogen capacity (ton)", "Sheet1", 1, 7);
excelFile.setCellValue("Hydrogen agent cash ", "Sheet1", 1, 8);
excelFile.setCellValue("Electricity demand ", "Sheet1", 1, 9);
excelFile.setCellValue("Electricity max available supply", "Sheet1", 1, 10);
excelFile.setCellValue("Electricity actual load factor", "Sheet1", 1, 11);


excelFile.setCellValue("Total cost", "Sheet1", 1, 12);
excelFile.setCellValue("Loan cost", "Sheet1", 1, 13);
excelFile.setCellValue("Electricity cost", "Sheet1", 1, 14);
excelFile.setCellValue("Fixed OPEX cost", "Sheet1", 1, 15);
excelFile.setCellValue("Variable OPEX cost", "Sheet1", 1, 16);
excelFile.setCellValue("CAPEX cost", "Sheet1", 1, 17);
]]></BeforeSimulationRunCode>
			<AfterSimulationRunCode><![CDATA[traceln("here");

for(int i = 0; i<root.energyDemand.demand_electricity_dataset.size();i++){
	double val0 = root.energyDemand.demand_electricity_dataset.getX(i);
	excelFile.setCellValue(round(val0), "Sheet1", i+2, 1);
	}

for(int i = 0; i < root.energyCoordinator.cordinator_hydrogenPrice_dataset.size(); i++){
	//hydrogen price
	double val = root.energyCoordinator.cordinator_hydrogenPrice_dataset.getY(i);
	//traceln(val);
	excelFile.setCellValue(roundToDecimal(val,2), "Sheet1", i+2, 2);
	}

for(int i = 0; i < root.energyCoordinator.cordinator_electricityPrice_dataset.size(); i++){
	//electricity price
	double val1 = root.energyCoordinator.cordinator_electricityPrice_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val1,2), "Sheet1", i+2, 3);
	}
for (int i = 0; i < root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset.size(); i++ ){	
	//proportion of hydrogen demand of the ATS satisfied
	double val3 = root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset
		.getY(i); 
	excelFile.setCellValue(roundToDecimal(val3,2), "Sheet1", i+2, 4);
	}
	
for (int i = 0; i < root.hydrogenProducer_PEM.hydrogen_demand_dataset.size();i++){
	//hydrogen demand
	double val4 = root.hydrogenProducer_PEM.hydrogen_demand_dataset
		.getY(i)/1000;
	excelFile.setCellValue(roundToDecimal(val4,2), "Sheet1", i+2, 5);
	}
for (int i = 0; i < root.hydrogenProducer_PEM.hydrogen_actualProduction_dataset.size(); i++){
	//hydrogen production
	double val5 = root.hydrogenProducer_PEM.hydrogen_actualProduction_dataset.
		getY(i)/1000;
	excelFile.setCellValue(roundToDecimal(val5,2), "Sheet1", i+2, 6);
}
for (int i =0; i< root.hydrogenProducer_PEM.hydrogen_maxProductionCapacity_dataset.size(); i++){
	//hydrogen capacity
	double val6 = root.hydrogenProducer_PEM.hydrogen_maxProductionCapacity_dataset.
		getY(i)/1000;
	excelFile.setCellValue(roundToDecimal(val6,2), "Sheet1", i+2, 7);
	
	//hydrogen agent cash on hand
	double val7 = root.hydrogenProducer_PEM.hydrogen_cashOnHand_dataset.
		getY(i);
	excelFile.setCellValue(roundToDecimal(val7,2), "Sheet1", i+2, 8);
	
	//electricity demand
	double val8 = root.energyCoordinator.cordinator_electricityDemand_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val8,2), "Sheet1", i+2, 9);
	
	//electricity supply
	double val9 = root.energySupply.electricitySupply.supply_electricity_dataset.
		getY(i);
	excelFile.setCellValue(roundToDecimal(val9,2), "Sheet1", i+2, 10);
	
	//electricity supply
	double val10 = root.energyCoordinator.cordinator_electricityLoadFactor_dataset.
		getY(i);
	excelFile.setCellValue(roundToDecimal(val10,2), "Sheet1", i+2, 11);
	}
	
	// total cost
for(int i = 0; i<root.hydrogenProducer_PEM.hydrogen_annualCost_dataset.size();i++){
	double val11 = root.hydrogenProducer_PEM.hydrogen_annualCost_dataset.
	getY(i);
	excelFile.setCellValue(roundToDecimal(val11,2), "Sheet1", i+2, 12);	
}

for (int i = 0; i < root.hydrogenProducer_PEM.hydrogen_loanCost_dataset.size();i++){	
	// loan cost
	double val12 = root.hydrogenProducer_PEM.hydrogen_loanCost_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val12,2), "Sheet1", i+2, 13);
	// electricity cost
	double val17 = root.hydrogenProducer_PEM.hydrogen_ElectricityCost_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val17,2), "Sheet1", i+2, 14);
	// fixed opexcost
	double val13 = root.hydrogenProducer_PEM.hydrogen_FixedOpexCost_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val13,2), "Sheet1", i+2, 15);
	// variable opexcost
	double val14 = root.hydrogenProducer_PEM.hydrogen_VariableOpexCost_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val14,2), "Sheet1", i+2, 16);
	// CAPEX cost
	double val15 = root.hydrogenProducer_PEM.hydrogen_CapexCost_dataset.getY(i);
	excelFile.setCellValue(roundToDecimal(val15,2), "Sheet1", i+2, 17);
	}]]></AfterSimulationRunCode>
