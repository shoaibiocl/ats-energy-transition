			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1762173641462</Id>
					<Name><![CDATA[notOperational]]></Name>
					<X>510</X><Y>140</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="170" Height="60">
						<ExitAction><![CDATA[//1. Estimate total demand for hydrogen across all the sectors.
final double TWH_TO_KG = 25_400_000;
double totalHydrogenDemand_TWh = 0;
totalHydrogenDemand_TWh = main.energyDemand.TotalEnergyDemand.sum(INDEX_CAN_VARY, Hydrogen);
// Convert the final TWh value to kg.
double totalHydrogenDemand_kg = totalHydrogenDemand_TWh * TWH_TO_KG;
demand_kg = totalHydrogenDemand_kg;

//2. Estimate total production capacity
double maxProduction = getMaxProduction();
annualCapacity_kg = maxProduction;
annualCapacity_TWh = (annualCapacity_kg)/(h2_HHV_to_kg_conversion*1000000); 

// 3. Estimate how much hydrogen needs to be produced.
annualProduction_kg = Math.min(demand_kg, maxProduction);

// 4. Calculate electricity reuirement 
double production_MWh = annualProduction_kg / h2_HHV_to_kg_conversion;
annualElectricityDemand_MWh = production_MWh / efficiency;]]></ExitAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1762173655677</Id>
					<Name><![CDATA[operational]]></Name>
					<X>510</X><Y>240</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="170" Height="280">
						<EntryAction><![CDATA[//traceln("Initiatlisation executed");
final double TWH_TO_KG = 25400000;
//double totalHydrogenDemand_TWh = 0;
//totalHydrogenDemand_TWh = main.energyDemand.TotalEnergyDemand.sum(INDEX_CAN_VARY, Hydrogen);
//traceln("Hydrogen agent: Demand for hydrogen "+totalHydrogenDemand_TWh);
// Convert the final TWh value to kg.
//double totalHydrogenDemand_kg = totalHydrogenDemand_TWh * TWH_TO_KG;
//demand_kg = totalHydrogenDemand_kg;

currentCapacity_kW_H2 = initialCapacity_kW_H2;
currentCapital = initialCapital;

double maxProduction = getMaxProduction();
annualCapacity_kg = maxProduction;

annualProduction_kg = Math.min(demand_kg, maxProduction);
//traceln("Annual demand : "+demand_kg);
//traceln("Annual production kg: "+annualProduction_kg);
annualProduction_MWh_H2 = annualProduction_kg/25.4; 
annualCapacity_TWh = (annualCapacity_kg)/(25.4*1000000); 
//double totalDemand_kg = demand_kg;

// CALCULATE AND STORE ANNUAL ELECTRICITY CONSUMPTION
double production_MWh = annualProduction_kg / h2_HHV_to_kg_conversion;
annualElectricityDemand_MWh = production_MWh / efficiency;
//traceln("Annual electricity demand: "+annualElectricityDemand_MWh);
//assuming for the first year electricity demanded is supplied. 
allocated_electricity_MW = annualElectricityDemand_MWh;

]]></EntryAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="operational" ParentStateId="1762173655677">
					<Id>1762184244760</Id>
					<Name><![CDATA[demandGen]]></Name>
					<X>530</X><Y>300</Y>
					<Label><X>5</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="120" Height="80">
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="operational" ParentStateId="1762173655677">
					<Id>1762184300675</Id>
					<Name><![CDATA[revenueCal]]></Name>
					<X>530</X><Y>440</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="120" Height="50">
						<EntryAction><![CDATA[double allocatedElectricity_MWh = allocated_electricity_MW;
//using the formula, update how much hydrogen actually produced based on allocated electricity
//1 MWh of electricity X efficiency X 25.4 kg H2
actualProduction_kg = allocatedElectricity_MWh * efficiency* h2_HHV_to_kg_conversion;
//traceln("actual production: "+actualProduction_kg);

//update electricity price
set_electricityPrice_per_MWh(main.energyCoordinator.electricityPrice);
//update hydrogen price
hydrogenPrice_per_kg = main.energyCoordinator.hydrogenPrice;

double cost = getAnnualCostForHydrogenPriceCalculation(annualProduction_kg);
//update data set 
hydrogen_annualCost_dataset.add(cost);
// Update cost. Setting if the production is zero then the base cost is 7. 
if (actualProduction_kg > 0) {
    cost_per_kg = ((cost / actualProduction_kg) > 0) ? (cost / actualProduction_kg) : 7;
   // traceln("Cost per kg: "+cost_per_kg);
} //else {
    //cost_per_kg = 0;
//}

//updating base cost of hydrogen with the energy cordinator
main.energyCoordinator.hydrogenBasePrice = cost_per_kg;


// CALCULATE FINANCIALS
double revenue = getAnnualRevenue(actualProduction_kg);
double interestEarned = limitMin(0, currentCapital) * 
capitalInterestRate;
double cost1 = getAnnualCostForProfitCalculation(annualProduction_kg);
double profit = (revenue + interestEarned) - cost1;
hydrogen_annualRevenue_dataset.add(revenue);
//double cost = getAnnualCost(actualProduction_kg);

//traceln("Year :"+time(YEAR)+" Cost: "+cost+" revenue: "+revenue);
//traceln("Current capital: "+currentCapital);
currentCapital += profit;
//traceln("Current capital: "+currentCapital);

// === 4. MAKE NEW EXPANSION DECISION ===
//traceln("******************");
//traceln("Calling expansion function: "+time(YEAR));
expandCapacity2();
//traceln("******************");
// 5. UPDATE LOANS
for (Loan loan : loanList) {
    loan.age_years++;
}
loanList.removeIf(loan -> loan.age_years >= loan.term_years);
// UPDATE EQUITY INVESTMENTS (EVERY YEAR)
// Loop through each active equity investment and decrease its remaining periods by one.
for (CapitalInvestment investment : equityInvestments) {
    investment.periodsRemaining--;
}
// After aging them, remove any investments from the list that have been fully amortized.
equityInvestments.removeIf(investment -> investment.periodsRemaining <= 0);

//reducing annual capex costs
annualCostReduction_LR();

// === 6. LOG SUMMARY ===
//traceln("Year " + time(YEAR) + " Summary: Capital: £" + currentCapital + ", Production: " + (int)annualProduction_kg + " kg, Cost/kg: £" + String.format("%.2f", cost_per_kg));
//traceln("----------------------------------------------------");
]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="EntryPoint" ParentState="ROOT_NODE">
					<Id>1762173638230</Id>
					<Name><![CDATA[statechart]]></Name>
					<X>550</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>0</X><Y>40</Y></Point>
					</Points>
					<Properties Target="1762173641462">
					</Properties>	
				</StatechartElement>
