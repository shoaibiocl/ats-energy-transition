		<ParamVariationExperiment ActiveObjectClassId="1747061152596">
			<Id>1762270958172</Id>
			<Name><![CDATA[SensitivityAnalysis]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[chart0.removeAll();
]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[double variable = root.fractionalTransitionOtherSectors;
Color color = lerpColor( (getCurrentIteration() - 1) / (double) (getMaximumIterations() - 1), blue, red );
chart0.addDataSet(root.energyCoordinator.cordinator_hydrogenPrice_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

chart1.addDataSet(root.energyCoordinator.cordinator_electricityPrice_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart2.addDataSet(root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart3.addDataSet(root.hydrogenProducer_PEM.hydrogen_actualProduction_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

chart4.addDataSet(root.hydrogenProducer_PEM.hydrogen_maxProductionCapacity_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart5.addDataSet(root.hydrogenProducer_PEM.hydrogen_capacityUtilisation_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart6.addDataSet(root.hydrogenProducer_PEM.hydrogen_demand_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

chart7.addDataSet(root.hydrogenProducer_PEM.hydrogen_cashOnHand_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart8.addDataSet(root.hydrogenProducer_PEM.hydrogen_annualCost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart9.addDataSet(root.hydrogenProducer_PEM.hydrogen_cost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart10.addDataSet(root.hydrogenProducer_PEM.hydrogen_annualRevenue_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

chart11.addDataSet(root.hydrogenProducer_PEM.hydrogen_FixedOpexCost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart12.addDataSet(root.hydrogenProducer_PEM.hydrogen_VariableOpexCost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart13.addDataSet(root.hydrogenProducer_PEM.hydrogen_CapexCost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart14.addDataSet(root.hydrogenProducer_PEM.hydrogen_loanCost_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

chart15.addDataSet(root.hydrogenProducer_PEM.hydrogen_CapexPerKw_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
chart16.addDataSet(root.energyCoordinator.cordinator_hydrogenAllocated_ATS_dataset, format( variable ), color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );

]]></AfterSimulationRunCode>
