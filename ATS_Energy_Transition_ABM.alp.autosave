			<Events>
				<Event>
					<Id>1759845396881</Id>
					<Name><![CDATA[annualUpdate]]></Name>
					<X>1020</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MONTH]]></Unit>
						</Rate>
						<Id>1759845396879</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1759910400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[YEAR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[ArrayList<Aircraft> removeList = new ArrayList<Aircraft>();

for(Aircraft a : AircraftList) {
	a.age += 1; 
	if (a.age >= a.lifetime){
		removeList.add(a);
		}
}

for (Aircraft a: removeList){
	updateFleetStock(a.distanceType, a.fuelType, "Remove");
	}

AircraftList.removeIf(a -> a.age >= a.lifetime);]]></Action>
				</Event>
				<Event>
					<Id>1759913428367</Id>
					<Name><![CDATA[monthlyUpdate]]></Name>
