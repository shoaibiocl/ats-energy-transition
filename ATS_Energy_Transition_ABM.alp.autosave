		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1750675160482</Id>
			<Name><![CDATA[EnergyDemand]]></Name>
			<StartupCode><![CDATA[//starting transition to hydrogen
//uncomment for all th esectors to transition from fossil to electricity
//all_sector_transition(years_to_transition);

ATS_transition(years_to_transition_ATS);
transport_transition(years_to_transition);
society_transition(years_to_transition);
industry_transition(years_to_transition);
//other_sector_transition(years_to_transition);
// giving demand of hydrogen to hydrogen agent
final double TWH_TO_KG = 25400000;
double totalHydrogenDemand_TWh = 0;
totalHydrogenDemand_TWh = TotalEnergyDemand.sum(INDEX_CAN_VARY, Hydrogen);

// Convert the final TWh value to kg.
//traceln("Total Hydrogen demand: "+totalHydrogenDemand_TWh);
double totalHydrogenDemand_kg = totalHydrogenDemand_TWh * TWH_TO_KG;
main.hydrogenProducer_PEM.demand_kg = totalHydrogenDemand_kg;]]></StartupCode>
