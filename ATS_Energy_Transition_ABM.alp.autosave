				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1759749590565</Id>
					<Name><![CDATA[underTransition]]></Name>
					<X>30</X><Y>370</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="185" Height="65">
						<EntryAction><![CDATA[transitionStartYear = infinity;
send("Transition started", main.hydrogenProducer_PEM);
for (int i = 1; i <= Sectors.size(); i++){
	if (i == 4){
		TotalEnergyDemand.set(TotalEnergyDemand.get(i, Fossil)
		-annualReduction.get(i), i, Fossil);
		TotalEnergyDemand.set(TotalEnergyDemand.get
		(i, Electricity)+annualReduction.get(i)*(1-hydrogenSplit_ATS), i, Electricity);
		TotalEnergyDemand.set(TotalEnergyDemand.get
		(i, Hydrogen)+annualReduction.get(i)*hydrogenSplit_ATS, i, Hydrogen);
		if(TotalEnergyDemand.get(i, Fossil) <= 0){
			annualReduction.set(0, i);
		}
	} else {
	TotalEnergyDemand.set(TotalEnergyDemand.get(i, Fossil)
	-annualReduction.get(i), i, Fossil);
	TotalEnergyDemand.set(TotalEnergyDemand.get
	(i, Electricity)+annualReduction.get(i)*(1-hydrogenSplit), i, Electricity);
	TotalEnergyDemand.set(TotalEnergyDemand.get
	(i, Hydrogen)+annualReduction.get(i)*hydrogenSplit, i, Hydrogen);
	if(TotalEnergyDemand.get(i, Fossil) <= 0){
		annualReduction.set(0, i);
	}}
}

nYears++;]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
