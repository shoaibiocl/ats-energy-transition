			annualReduction.set(0, i);
		}
	} else {
	TotalEnergyDemand.set(TotalEnergyDemand.get(i, Fossil)
	-annualReduction.get(i), i, Fossil);
	TotalEnergyDemand.set(TotalEnergyDemand.get
	(i, Electricity)+annualReduction.get(i)*(1-hydrogenSplit), i, Electricity);
	TotalEnergyDemand.set(TotalEnergyDemand.get
	(i, Hydrogen)+annualReduction.get(i)*hydrogenSplit, i, Hydrogen);
	if(TotalEnergyDemand.get(i, Fossil) &lt;= 0){
		annualReduction.set(0, i);
	}}
}

