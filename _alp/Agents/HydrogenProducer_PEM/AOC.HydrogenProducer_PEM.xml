			<ShowLabel>true</ShowLabel>
			<Properties Width="120" Height="50">
				<EntryAction>double allocatedElectricity_MWh = allocated_electricity_MW;
//using the formula, update how much hydrogen actually produced based on allocated electricity
//1 MWh of electricity X efficiency X 25.4 kg H2
actualProduction_kg = allocatedElectricity_MWh * efficiency* h2_HHV_to_kg_conversion;
//traceln("actual production: "+actualProduction_kg);

//update electricity price
set_electricityPrice_per_MWh(main.energyCoordinator.electricityPrice);
//update hydrogen price
hydrogenPrice_per_kg = main.energyCoordinator.hydrogenPrice;

double cost = getAnnualCostForHydrogenPriceCalculation(annualProduction_kg);
//update data set 
hydrogen_annualCost_dataset.add(cost);
// Update cost. Setting if the production is zero then the base cost is 7. 
if (actualProduction_kg &gt; 0) {
    cost_per_kg = ((cost / actualProduction_kg) &gt; 0) ? (cost / actualProduction_kg) : 7;
   // traceln("Cost per kg: "+cost_per_kg);
} //else {
    //cost_per_kg = 0;
//}

//updating base cost of hydrogen with the energy cordinator
main.energyCoordinator.hydrogenBasePrice = cost_per_kg;


// CALCULATE FINANCIALS
double revenue = getAnnualRevenue(actualProduction_kg);
double interestEarned = limitMin(0, currentCapital) * 
capitalInterestRate;
double cost1 = getAnnualCostForProfitCalculation(annualProduction_kg);
double profit = (revenue + interestEarned) - cost1;
hydrogen_annualRevenue_dataset.add(revenue);
//double cost = getAnnualCost(actualProduction_kg);

//traceln("Year :"+time(YEAR)+" Cost: "+cost+" revenue: "+revenue);
//traceln("Current capital: "+currentCapital);
currentCapital += profit;
//traceln("Current capital: "+currentCapital);

// === 4. MAKE NEW EXPANSION DECISION ===
//traceln("******************");
//traceln("Calling expansion function: "+time(YEAR));
expandCapacity2();
//traceln("******************");
// 5. UPDATE LOANS
for (Loan loan : loanList) {
    loan.age_years++;
}
loanList.removeIf(loan -&gt; loan.age_years &gt;= loan.term_years);
// UPDATE EQUITY INVESTMENTS (EVERY YEAR)
// Loop through each active equity investment and decrease its remaining periods by one.
for (CapitalInvestment investment : equityInvestments) {
    investment.periodsRemaining--;
}
// After aging them, remove any investments from the list that have been fully amortized.
equityInvestments.removeIf(investment -&gt; investment.periodsRemaining &lt;= 0);

//reducing annual capex costs
annualCostReduction_LR();

// === 6. LOG SUMMARY ===
//traceln("Year " + time(YEAR) + " Summary: Capital: £" + currentCapital + ", Production: " + (int)annualProduction_kg + " kg, Cost/kg: £" + String.format("%.2f", cost_per_kg));
//traceln("----------------------------------------------------");
</EntryAction>
