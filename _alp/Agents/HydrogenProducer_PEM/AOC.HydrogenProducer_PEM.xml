			<Properties Width="170" Height="280">
				<EntryAction>//traceln("Initiatlisation executed");
final double TWH_TO_KG = 25400000;
//double totalHydrogenDemand_TWh = 0;
//totalHydrogenDemand_TWh = main.energyDemand.TotalEnergyDemand.sum(INDEX_CAN_VARY, Hydrogen);
//traceln("Hydrogen agent: Demand for hydrogen "+totalHydrogenDemand_TWh);
// Convert the final TWh value to kg.
//double totalHydrogenDemand_kg = totalHydrogenDemand_TWh * TWH_TO_KG;
//demand_kg = totalHydrogenDemand_kg;

currentCapacity_kW_H2 = initialCapacity_kW_H2;
currentCapital = initialCapital;

double maxProduction = getMaxProduction();
annualCapacity_kg = maxProduction;

annualProduction_kg = Math.min(demand_kg, maxProduction);
//traceln("Annual demand : "+demand_kg);
//traceln("Annual production kg: "+annualProduction_kg);
annualProduction_MWh_H2 = annualProduction_kg/25.4; 
annualCapacity_TWh = (annualCapacity_kg)/(25.4*1000000); 
//double totalDemand_kg = demand_kg;

// CALCULATE AND STORE ANNUAL ELECTRICITY CONSUMPTION
double production_MWh = annualProduction_kg / h2_HHV_to_kg_conversion;
annualElectricityDemand_MWh = production_MWh / efficiency;
//traceln("Annual electricity demand: "+annualElectricityDemand_MWh);
//assuming for the first year electricity demanded is supplied. 
allocated_electricity_MW = annualElectricityDemand_MWh;

</EntryAction>
