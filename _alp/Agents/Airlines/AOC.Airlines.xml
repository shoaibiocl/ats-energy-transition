<ActiveObjectClass>
	<Id>1759844514969</Id>
	<Name><![CDATA[Airlines]]></Name>
	<StartupCode><![CDATA[AircraftList.clear();
// number of aircraft to create
int n = 10;
// set max lifetime for all aircraft
int lifetime = 25;
// loop to create aircraft
for (int i = 1; i <= n; i++) {
    // random number for distance category
    double r = random();
    String distanceType;
    if (r < 0.5) {
        distanceType = "short";      // 50% chance
    } else if (r < 0.8) {
        distanceType = "medium";     // 30% chance
    } else {
        distanceType = "long";       // 20% chance
    }
    // random age between 0 and lifetime - 1
    int age = (int) uniform(0, lifetime);
    // create aircraft and add to list
    AircraftList.add(new Aircraft("AC" + numAircraft, distanceType, "Kerosene", age, lifetime));
	numAircraft ++;
	updateFleetStock(distanceType, "Kerosene", "Add");
}

// print confirmation
//trace("Generated " + AircraftList.size() + " kerosene aircraft.");
]]></StartupCode>
